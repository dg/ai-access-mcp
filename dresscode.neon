use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests
	- server.php

excludePaths:
	- tests/**/output

fileExtensions:
	- php
	- phpt

imports:
	grouping:
		class: grouped

functions:
	namedBooleanArgument: required

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations
