# USD per million tokens, per model; the first period whose `until` has not passed applies.
# A model without a valid period reports its cost as unknown. Quote the dates, NEON would decode them.
#
# https://developers.openai.com/api/docs/pricing, checked 2026-11-09, Standard tier

gpt-image-2:
	- {inputText: 5.00, inputImage: 8.00, outputImage: 30.00}

gpt-image-1.5:
	- {inputText: 5.00, inputImage: 8.00, outputImage: 32.00, outputText: 10.00}

gpt-image-1-mini:
	- {inputText: 2.00, inputImage: 2.50, outputImage: 8.00}

gpt-5.6-terra:
	- {input: 2.00, cachedInput: 0.20, output: 12.00}

gpt-5.6-luna:
	- {input: 0.20, cachedInput: 0.02, output: 1.20}

gpt-5.5:
	- {input: 5.00, cachedInput: 0.50, output: 30.00}

gpt-5.4:
	- {input: 2.50, cachedInput: 0.25, output: 15.00}

gpt-5.4-mini:
	- {input: 0.75, cachedInput: 0.075, output: 4.50}

# Gemini doubles its prices on 2027-01-01; checked 2026-11
gemini-3.8-flash:
	- {until: '2026-12-31', input: 0.75, cachedInput: 0.075, output: 3.75, cacheStorageHour: 0.50}
	- {input: 1.50, cachedInput: 0.15, output: 7.50, cacheStorageHour: 1.00}
