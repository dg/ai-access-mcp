# USD per million tokens, per model; the first period whose `until` has not passed applies.
# A model without a valid period reports its cost as unknown. Quote the dates, NEON would decode them.
#
# https://developers.openai.com/api/docs/pricing and https://aistudio.google.com/docs/pricing,
# checked 2026-11-10, Standard tier, prompts up to 200k tokens

gpt-image-2:
	- {inputText: 5.00, inputImage: 8.00, outputImage: 30.00}

gpt-image-2.5-sunburst:
	- {inputText: 5.00, inputImage: 8.00, outputImage: 30.00}

gpt-image-2.5-flare:
	- {inputText: 5.00, inputImage: 8.00, outputImage: 30.00}

gpt-image-2.6-sunburst:
	- {inputText: 5.00, inputImage: 8.00, outputImage: 30.00}

gpt-image-2.6-flare:
	- {inputText: 5.00, inputImage: 8.00, outputImage: 30.00}

gpt-image-1.5:
	- {inputText: 5.00, inputImage: 8.00, outputImage: 32.00, outputText: 10.00}

gpt-image-1-mini:
	- {inputText: 2.00, inputImage: 2.50, outputImage: 8.00}

chatgpt-image-latest:
	- {inputText: 5.00, inputImage: 8.00, outputImage: 32.00, outputText: 10.00}

gpt-6-astra:
	- {input: 10.00, cachedInput: 1.00, output: 50.00}

gpt-6.1-sol:
	- {input: 2.00, cachedInput: 0.10, output: 10.00}

gpt-6.1-terra:
	- {input: 1.00, cachedInput: 0.05, output: 5.00}

gpt-6-sol:
	- {input: 2.00, cachedInput: 0.20, output: 10.00}

gpt-6-luna:
	- {input: 0.10, cachedInput: 0.01, output: 0.50}

# a promotional price, the page does not say what follows it
gpt-5.6-sol:
	- {until: '2026-11-30', input: 4.00, cachedInput: 0.40, output: 20.00}

gpt-5.6-terra:
	- {input: 2.00, cachedInput: 0.20, output: 12.00}

gpt-5.6-luna:
	- {input: 0.20, cachedInput: 0.02, output: 1.20}

gpt-5.5:
	- {input: 5.00, cachedInput: 0.50, output: 30.00}

gpt-5.4:
	- {input: 2.50, cachedInput: 0.25, output: 15.00}

gpt-5.4-mini:
	- {input: 0.75, cachedInput: 0.075, output: 4.50}

gpt-5.4-nano:
	- {input: 0.20, cachedInput: 0.02, output: 1.25}

# the page lists no price for keeping its cache
gemini-4-argon:
	- {until: '2026-11-30', input: 2.00, cachedInput: 0.10, output: 10.00}
	- {input: 4.00, cachedInput: 0.20, output: 20.00}

gemini-3.8-flash:
	- {until: '2026-12-31', input: 0.75, cachedInput: 0.075, output: 3.75, cacheStorageHour: 0.50}
	- {input: 1.50, cachedInput: 0.15, output: 7.50, cacheStorageHour: 1.00}

gemini-3.6-flash:
	- {until: '2026-12-31', input: 0.75, cachedInput: 0.075, output: 3.75, cacheStorageHour: 0.50}
	- {input: 1.50, cachedInput: 0.15, output: 7.50, cacheStorageHour: 1.00}

gemini-3.5-flash-lite:
	- {input: 0.30, cachedInput: 0.03, output: 2.50, cacheStorageHour: 1.00}

gemini-3.1-flash-lite:
	- {input: 0.25, cachedInput: 0.025, output: 1.50, cacheStorageHour: 1.00}

gemini-3.1-pro-preview:
	- {input: 2.00, cachedInput: 0.20, output: 12.00, cacheStorageHour: 4.50}
